{
  "name": "@comchatx/cx-board-tasks",
  "version": "0.3.0",
  "description": "Puts what cx found and what needs your answer in your Inbox.",
  "license": "MIT",
  "author": "ComChatX",
  "homepage": "https://github.com/comchatx/cx-board-tasks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-board-tasks.git"
  },
  "bugs": "https://github.com/comchatx/cx-board-tasks/issues",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "skills",
    "page",
    "README.zh-CN.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "comchatx": {
    "name": "Board Inbox",
    "about": "cx 的发现和要你决定的事放进收件箱，在那里直接回答。",
    "mark": {
      "line": "clipboard"
    },
    "section": "extensions",
    "order": 111,
    "board": {
      "tab": "待办",
      "page": "page/inbox.html",
      "name": {
        "zh": "收件箱",
        "en": "Inbox"
      }
    },
    "skills": {
      "cx-board-tasks": {
        "about": {
          "en": "The seller's Inbox on the board, where you leave what you found, changed, propose and ask, as cards the seller marks as read or answers.",
          "zh": "告诉 cx 收件箱写什么、你的回答如何传回。"
        }
      }
    },
    "builds": [
      "@comchatx/cx-board"
    ]
  },
  "devDependencies": {
    "@comchatx/cx-board": "0.3.3",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.2.0",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
